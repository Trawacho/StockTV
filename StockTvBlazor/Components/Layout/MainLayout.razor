@inherits LayoutComponentBase

<ThemeHandler />
@* Eigene interaktive Insel: das Layout selbst wird statisch gerendert, nur die Seite in
   @Body ist interaktiv. Ohne @rendermode bekaeme der Tracker keinen Circuit und damit
   weder LocationChanged noch RendererInfo.IsInteractive. *@
<MainWindowTracker @rendermode="InteractiveServer" />

@Body

<div id="blazor-error-ui" data-nosnippet>
	An unhandled error has occurred.
	<a href="." class="reload">Reload</a>
	<span class="dismiss">🗙</span>
</div>
