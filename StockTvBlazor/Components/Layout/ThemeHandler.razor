@rendermode InteractiveServer

<style @key="_updateCounter">
    :root {
        --bg-color: @_settings.UI.Colors.BackgroundColor;
        --fg-color: @_settings.UI.Colors.ForegroundColor;
        --fg-left: @_settings.UI.Colors.ForegroundA;
        --fg-right: @_settings.UI.Colors.ForegroundB;
        --fg-color-teamname-left: @_settings.UI.Colors.TeamNameA;
        --fg-color-teamname-right: @_settings.UI.Colors.TeamNameB;
        --fg-color-ziel-gesamt: @_settings.UI.Colors.ZielSummeGesamt;
        --fg-color-ziel-einzel: @_settings.UI.Colors.ZielSummeEinzel;
        --fg-color-ziel-spielername: @_settings.UI.Colors.ZielSpielername;
        --font-family: @(!string.IsNullOrEmpty(_settings.UI.Colors.FontFamily) ? $"\"{_settings.UI.Colors.FontFamily}\"" : "inherit");
    }
</style>
