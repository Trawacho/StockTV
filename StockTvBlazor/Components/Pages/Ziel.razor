@page "/ziel"
@rendermode InteractiveServer

<PageTitle>Zielbewerb</PageTitle>

<div class="ziel-main-grid page-fullscreen" @onkeydown="HandleGlobalKeyDown" tabindex="0" style="outline:none;" @ref="inputRef">

	@if (ViewModel.IsSpielernameAvailable)
	{
		<div class="ziel-spielername"><AutoFitText Text="@ViewModel.SpielerName" Min="8" /></div>
	}

	<div class="ziel-block">

		<div class="ziel-row ziel-row-top">
			<div class="ziel-cell ziel-versuche">
				<AutoFitText Text="@ViewModel.AnzahlVersuche" Min="10" />
			</div>
			<div class="ziel-cell ziel-gesamt">
				<AutoFitText Text="@ViewModel.GesamtText" Min="10" />
			</div>
		</div>

		<div class="ziel-row ziel-row-mid">

			@if (ViewModel.InvalidInput)
			{
				<div class="ziel-overlay show">
					ungültig
				</div>
			}

			<div class="ziel-cell ziel-col-a">
				<AutoFitText Text="@ViewModel.LastValue" Min="10" />
			</div>

			<div class="ziel-cell ziel-col-b input-value">
				<AutoFitText Text="@ViewModel.InputValue" Min="10" />
			</div>
			<div class="ziel-cell ziel-col-c">
				<AutoFitText Text="@ViewModel.GesamtPunkteText" Min="10" />
			</div>
		</div>

		<div class="ziel-row ziel-row-bottom">
			<div class="ziel-cell ziel-summe">
				<AutoFitText Text="@ViewModel.SummeDerVersuche" Min="8" />
			</div>
		</div>

	</div>
</div>
