@page "/"
@rendermode InteractiveServer
@using StockTvBlazor.Components.Pages
@inherits HomeBase

<PageTitle>StockTV</PageTitle>

<ErrorBoundary>
    <ChildContent>
    <div class="home-page">
        <div class="home-container">
            <div class="hero">
                <h1>StockTV</h1>
                <p>Die Anzeige für den Stocksport</p>
            </div>

            @* Buehne fuer die rotierenden Karten: feste Hoehe, damit das Layout beim
               Wechsel nicht springt. @key sorgt dafuer, dass Blazor den Slot neu
               aufbaut und die Einblend-Animation erneut laeuft. *@
            <div class="card-stage">
                @if (CardComponents.Count > currentCardIndex)
                {
                    <div class="card-slot" @key="currentCardIndex">
                        <DynamicComponent Type="CardComponents[currentCardIndex]" />
                    </div>
                }
                else
                {
                    <p class="card-error">Card Fehler</p>
                }
            </div>

            <div class="card-dots">
                @for (var i = 0; i < CardComponents.Count; i++)
                {
                    <span class="dot @(i == currentCardIndex ? "active" : "")"></span>
                }
            </div>

            <div class="banner-image">
                <img src="/images/StockTV_Logo1.png" alt="StockTV Logo" />
            </div>
        </div>

        <div class="cta">
            <p>Weiterleitung in <strong>@countdown Sekunden</strong>...</p>
            <div class="progress-bar">
                <div class="progress" style="width:@progress%"></div>
            </div>
        </div>
    </div>

    </ChildContent>

    <ErrorContent Context="ex">
        <div style="color:red; padding:20px;">
            <h3>⚠ Fehler auf der Seite</h3>
            <p>@ex.Message</p>
            <pre>@ex.StackTrace</pre>
        </div>
    </ErrorContent>
</ErrorBoundary>
