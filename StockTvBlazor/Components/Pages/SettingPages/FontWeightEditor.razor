<div class="layout-editor">
    <div class="layout-editor-header">
        <button class="btn-cancel" @onclick="ResetAll">Alle Werte zurücksetzen</button>
    </div>

    <div class="font-weight-section">
        <h4>Team &amp; Kopfzeile</h4>
        <FontWeightField Label="Team-Namen (Turnier / BestOf)" DefaultValue="400" @bind-Value="Weights.TeamNameWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Kopfzeile (Training / Turnier / BestOf)" DefaultValue="700" @bind-Value="Weights.HeaderRowWeight" @bind-Value:after="NotifyChanged" />
    </div>

    <div class="font-weight-section">
        <h4>Training / Turnier / BestOf — Punkte-Zellen</h4>
        <FontWeightField Label="Punkte-Summe (Spielstand)" DefaultValue="700" @bind-Value="Weights.PointsSumWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Aktuelle Kehre-Punkte" DefaultValue="700" @bind-Value="Weights.CurrentPointsWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Eingabe (Tippbuffer)" DefaultValue="700" @bind-Value="Weights.InputValueWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Trenner ':'" DefaultValue="600" @bind-Value="Weights.SeparatorWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Matchpunkte (BestOf)" DefaultValue="200" @bind-Value="Weights.BestOfMatchPointsWeight" @bind-Value:after="NotifyChanged" />
    </div>

    <div class="font-weight-section">
        <h4>Ziel — Werte-Zellen</h4>
        <FontWeightField Label="Spielername" DefaultValue="600" @bind-Value="Weights.ZielSpielernameWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Versuche" DefaultValue="500" @bind-Value="Weights.ZielVersucheWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Gesamt" DefaultValue="500" @bind-Value="Weights.ZielGesamtWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Letzter Wert" DefaultValue="500" @bind-Value="Weights.ZielLetzterWertWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Ziel-Eingabe" DefaultValue="500" @bind-Value="Weights.ZielEingabeWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Gesamtpunkte" DefaultValue="500" @bind-Value="Weights.ZielGesamtpunkteWeight" @bind-Value:after="NotifyChanged" />
        <FontWeightField Label="Summe" DefaultValue="500" @bind-Value="Weights.ZielSummeWeight" @bind-Value:after="NotifyChanged" />
    </div>

    <div class="preview-section">
        <h4>Vorschau</h4>
        <ThemePreview />
    </div>
</div>
