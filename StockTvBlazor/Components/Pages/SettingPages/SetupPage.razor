@page "/setup"
@rendermode InteractiveServer

<PageTitle>System</PageTitle>

@if (!PlatformInfo.IsRaspberryPi)
{
    <div class="setup-page setup-page-message">
        <h3>System</h3>
        <p>Dies ist kein Raspberry Pi, diese Funktion ist hier nicht verfügbar.</p>
    </div>
}
else if (HasRecordedValues)
{
    <div class="setup-page setup-page-message">
        <h3>System</h3>
        <p>Es sind bereits Werte (Kehren bzw. Zielwerte) hinterlegt. Aus Sicherheitsgründen können
           hier keine Änderungen vorgenommen werden, solange das laufende Spiel Daten enthält.</p>
    </div>
}
else
{
    <div class="setup-page">
        <nav class="setup-nav">
            <div class="setup-nav-header">
                <h2>System</h2>
            </div>
            <div class="setup-nav-list">
                <button class="setup-nav-item @(_activeSection == SetupSection.Hostname ? "active" : "")" @onclick="() => _activeSection = SetupSection.Hostname">Hostname</button>
                <button class="setup-nav-item @(_activeSection == SetupSection.Netzwerk ? "active" : "")" @onclick="() => _activeSection = SetupSection.Netzwerk">Netzwerk</button>
                <button class="setup-nav-item @(_activeSection == SetupSection.Update ? "active" : "")" @onclick="() => _activeSection = SetupSection.Update">Update</button>
                <button class="setup-nav-item @(_activeSection == SetupSection.Neustart ? "active" : "")" @onclick="() => _activeSection = SetupSection.Neustart">Neustart</button>
            </div>
        </nav>

        <div class="setup-content-panel">
            @if (_activeSection == SetupSection.Hostname)
            {
                <section class="hostname-section">
                    <h2>Hostname</h2>
                    <p class="section-description">Der Hostname identifiziert diesen Pi im Netzwerk, z.B. bei der
                        automatischen Erkennung per mDNS durch das zentrale Verwaltungsprogramm.</p>
                    <p class="hint">Nach dem Ändern ist ein Neustart des Pi nötig, damit die Änderung überall (z.B. mDNS) wirksam wird.</p>

                    <div class="field">
                        <label>Hostname</label>
                        <input type="text" @bind="_hostnameText" placeholder="stocktv-bahn1" />
                    </div>

                    <div class="field-actions">
                        <button class="btn-save" disabled="@_isApplyingHostname" @onclick="ApplyHostnameAsync">
                            @(_isApplyingHostname ? "Wird angewendet…" : "Speichern")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_hostnameErrorMessage))
                    {
                        <div class="toast-error">@_hostnameErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_hostnameSuccessMessage))
                    {
                        <div class="toast-success">@_hostnameSuccessMessage</div>
                    }
                </section>
            }
            else if (_activeSection == SetupSection.Netzwerk)
            {
                <section class="network-section">
                    <h2>Netzwerk</h2>
                    <p class="section-description">Verbindungseinstellungen dieses Pi im lokalen Netzwerk — feste IP-Adresse
                        oder automatisch per DHCP.</p>

                    <div class="warning-box">
                        ⚠ Eine fehlerhafte Konfiguration kann den Pi vom Netz trennen. Falls die Seite danach
                        nicht mehr erreichbar ist: per SSH verbinden und <code>nmtui</code> nutzen (siehe
                        INSTALL.md). Falls der Browser gerade über das geänderte Interface verbunden ist, kann
                        die Verbindung während der Änderung kurz abreißen.
                    </div>

                    @if (_loadingInterfaces)
                    {
                        <p>Lade Netzwerk-Interfaces…</p>
                    }
                    else if (_interfaces.Count == 0)
                    {
                        <p>Keine Netzwerk-Interfaces gefunden.</p>
                    }
                    else
                    {
                        <div class="field">
                            <label>Interface</label>
                            <select value="@_selectedDevice" @onchange="OnDeviceChangedAsync">
                                @foreach (var iface in _interfaces)
                                {
                                    <option value="@iface.Device">
                                        @iface.Device
                                    </option>
                                }
                            </select>
                        </div>

                        @if (_selectedInterface is { ConnectionName: null })
                        {
                            <p class="hint">Dieses Interface hat keine aktive Verbindung, Konfiguration hier nicht unterstützt.</p>
                        }
                        else if (_details is not null)
                        {
                            <div class="field">
                                <label>Modus</label>
                                <div class="radio-group">
                                    <label><input type="radio" name="mode" checked="@(!_isStaticMode)" @onchange="() => _isStaticMode = false" /> DHCP (automatisch)</label>
                                    <label><input type="radio" name="mode" checked="@_isStaticMode" @onchange="() => _isStaticMode = true" /> Statisch</label>
                                </div>
                            </div>

                            @if (_isStaticMode)
                            {
                                <div class="field">
                                    <label>IP-Adresse / Präfix <span class="hint">(Präfix z.B. 24 = 255.255.255.0)</span></label>
                                    <div class="ip-prefix-group">
                                        <input type="text" @bind="_ipText" @bind:event="oninput" placeholder="192.168.1.50" class="ip-input" />
                                        <span class="ip-prefix-separator">/</span>
                                        <input type="text" @bind="_prefixText" placeholder="24" class="prefix-input" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label>Gateway</label>
                                    <input type="text" @bind="_gatewayText" placeholder="192.168.1.1" />
                                </div>
                                <div class="field">
                                    <label>DNS-Server <span class="hint">(kommagetrennt)</span></label>
                                    <input type="text" @bind="_dnsText" placeholder="192.168.1.1, 1.1.1.1" />
                                    <p class="hint">Meist die IP Ihres Routers (hier auch als Gateway eingetragen). Alternativ öffentliche DNS-Server wie 1.1.1.1 und/oder 8.8.8.8.</p>
                                </div>

                                @if (GetTargetUrlPreview() is { } targetUrlPreview)
                                {
                                    <p class="hint target-url-preview">
                                        Nach dem Speichern erreichbar unter: <strong>@targetUrlPreview</strong>
                                        @if (_selectedInterface?.Device is not null)
                                        {
                                            <text> (falls Sie über <strong>@_selectedInterface.Device</strong> verbunden sind, bitte diese Adresse notieren, bevor Sie speichern)</text>
                                        }
                                    </p>
                                }
                            }
                            else
                            {
                                <div class="readonly-info">
                                    <p>Aktuelle IP: @(_details.IpAddress ?? "-")@(_details.Prefix is not null ? $"/{_details.Prefix}" : "")</p>
                                    <p>Gateway: @(_details.Gateway ?? "-")</p>
                                    <p>DNS: @(_details.DnsServers.Count > 0 ? string.Join(", ", _details.DnsServers) : "-")</p>
                                </div>
                            }

                            <div class="field-actions">
                                <button class="btn-save" disabled="@_isApplyingNetwork" @onclick="ApplyNetworkChangesAsync">
                                    @(_isApplyingNetwork ? "Wird angewendet…" : "Speichern")
                                </button>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrEmpty(_networkErrorMessage))
                    {
                        <div class="toast-error">@_networkErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_networkSuccessMessage))
                    {
                        <div class="toast-success">@_networkSuccessMessage</div>
                    }
                </section>
            }
            else if (_activeSection == SetupSection.Update)
            {
                <section class="update-section">
                    <h2>Update</h2>
                    <p class="section-description">App-Version aktuell halten — automatisch über das Internet, oder
                        manuell durch Hochladen einer Release-Datei, falls dieser Pi keinen Internetzugang hat.</p>

                    <p>Aktuelle Version: @UpdateService.GetCurrentVersion()</p>

                    <div class="field-actions">
                        <button class="btn-secondary" disabled="@_isCheckingUpdate" @onclick="CheckForUpdateAsync">
                            @(_isCheckingUpdate ? "Prüfe…" : "Auf Update prüfen")
                        </button>

                        @if (_updateCheckResult is { UpdateAvailable: true })
                        {
                            <button class="btn-save" disabled="@(_isUpdating || UpdateService.UpdateInProgress)" @onclick="StartUpdateAsync">
                                @(_isUpdating || UpdateService.UpdateInProgress ? "Update läuft…" : "Update starten")
                            </button>
                        }
                    </div>

                    @if (_updateCheckResult is not null)
                    {
                        <p class="update-result">
                            @if (_updateCheckResult.ErrorMessage is not null)
                            {
                                @_updateCheckResult.ErrorMessage
                            }
                            else if (_updateCheckResult.UpdateAvailable)
                            {
                                @($"Update verfügbar: Version {_updateCheckResult.LatestVersion} (aktuell {_updateCheckResult.CurrentVersion})")
                            }
                            else
                            {
                                @($"Bereits aktuell (Version {_updateCheckResult.CurrentVersion})")
                            }
                        </p>
                    }

                    @if (_updateStartedMessage is not null)
                    {
                        <p class="update-result">@_updateStartedMessage</p>
                    }

                    <h3>Offline-Update</h3>
                    <p class="hint">Falls dieser Pi keinen Internetzugang hat: Release-Zip (z.B. von
                        <a href="https://github.com/Trawacho/StockTV/releases" target="_blank" rel="noopener">GitHub Releases</a>)
                        manuell hochladen und von hier installieren.</p>

                    <div class="field">
                        <label>Release-Zip (stocktv-rpi.zip)</label>
                        <InputFile OnChange="OnOfflinePackageSelectedAsync" accept=".zip" disabled="@(_isUploadingOfflinePackage || _isStartingOfflineUpdate || UpdateService.UpdateInProgress)" />
                    </div>

                    @if (_isUploadingOfflinePackage)
                    {
                        <p class="hint upload-progress">
                            <span class="spinner" aria-hidden="true"></span>
                            Datei wird hochgeladen und geprüft… (bricht nach @StockTvBlazor.Services.UpdateService.OfflineUpdateUploadTimeout.TotalMinutes.ToString("0") Minuten automatisch ab, falls die Verbindung hängt)
                        </p>
                    }

                    <div class="field-actions">
                        <button class="btn-save" disabled="@(!_offlineUpdateReady || _isStartingOfflineUpdate || UpdateService.UpdateInProgress)" @onclick="StartOfflineUpdateAsync">
                            @(_isStartingOfflineUpdate || UpdateService.UpdateInProgress ? "Update läuft…" : "Update aus Datei starten")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(_offlineUpdateErrorMessage))
                    {
                        <div class="toast-error">@_offlineUpdateErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_offlineUpdateSuccessMessage))
                    {
                        <div class="toast-success">@_offlineUpdateSuccessMessage</div>
                    }
                </section>
            }
            else if (_activeSection == SetupSection.Neustart)
            {
                <section class="reboot-section">
                    <h2>Neustart</h2>
                    <p class="section-description">Startet den Raspberry Pi sofort neu. Laufende Spiele/Verbindungen werden unterbrochen.</p>

                    <div class="field-actions">
                        @if (!_rebootArmed)
                        {
                            <button class="btn-secondary" @onclick="() => _rebootArmed = true">
                                Pi neu starten
                            </button>
                        }
                        else
                        {
                            <button class="btn-danger" disabled="@_isRebooting" @onclick="RebootAsync">
                                @(_isRebooting ? "Startet neu…" : "Wirklich neu starten?")
                            </button>
                            <button class="btn-secondary" disabled="@_isRebooting" @onclick="() => _rebootArmed = false">
                                Abbrechen
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_rebootErrorMessage))
                    {
                        <div class="toast-error">@_rebootErrorMessage</div>
                    }
                </section>
            }
        </div>
    </div>
}
