@page "/bestof"
@rendermode InteractiveServer

<PageTitle>BestOf</PageTitle>

<div class="page-fullscreen" @onkeydown="HandleGlobalKeyDown" tabindex="0" style="outline:none;" @ref="inputRef">
	<div class="scoreboard-shell" style="@ViewModel.GetShellGridStyle()">
		@if (TeamNamesAvailable)
		{
			<div class="teamname teamname-left"><AutoFitText Text="@ViewModel.LeftTeamName" Min="8" Vertical="true" /></div>
		}

		<div class="scoreboard-center">
			<div class="score-row score-top-row header-text"><AutoFitText Text="@ViewModel.HeaderText" Min="6" /></div>

			<div class="score-row bestof-mid-grid">
				<div class="score-cell left-point-sum"><AutoFitText Text="@ViewModel.LeftPointsSum.ToString()" Min="12" /></div>
				<div class="score-cell left-match-points">@ViewModel.LeftMatchPoints</div>
				<div class="score-cell seperator"><AutoFitText Text=":" Min="12" /></div>
				<div class="score-cell right-match-points">@ViewModel.RightMatchPoints</div>
				<div class="score-cell right-point-sum"><AutoFitText Text="@ViewModel.RightPointsSum.ToString()" Min="12" /></div>
			</div>

			<div class="score-row score-bottom-grid">
				<div class="score-cell left-points"><AutoFitText Text="@ViewModel.LeftPoints" Min="10" /></div>
				<div class="score-cell input-value"><AutoFitText Text="@ViewModel.InputValue" Min="10" /></div>
				<div class="score-cell right-points"><AutoFitText Text="@ViewModel.RightPoints" Min="10" /></div>
			</div>
		</div>

		@if (TeamNamesAvailable)
		{
			<div class="teamname teamname-right"><AutoFitText Text="@ViewModel.RightTeamName" Min="8" Vertical="true" /></div>
		}
	</div>
</div>
